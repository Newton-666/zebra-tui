{
  "name": "zebra",
  "version": "0.1.0",
  "description": "Zebra — multi-agent team cockpit TUI, built on pi-tui",
  "type": "module",
  "private": true,
  "bin": {
    "zebra": "./zebra"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "smoke": "KRISTAL_SESSIONS_DIR=/tmp/krystal-test-sessions node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "test:memory": "node --experimental-strip-types --no-warnings scripts/memory-tests.ts",
    "test:render": "node --experimental-strip-types --no-warnings scripts/bot-render-tests.ts",
    "test:commands": "node --experimental-strip-types --no-warnings scripts/bot-command-tests.ts",
    "test:divert": "node --experimental-strip-types --no-warnings scripts/bot-divert-tests.ts",
    "test:login": "node --experimental-strip-types --no-warnings scripts/bot-login-tests.ts",
    "eval:memory": "node --experimental-strip-types --no-warnings scripts/memory-eval.ts",
    "guard": "node --experimental-strip-types --no-warnings scripts/harness-guard.ts"
  }
}
